# Everything here is fake and safe to commit. Copy to .env before `npm run setup`.
DATABASE_URL="file:./dev.db"

# The whole codebase reads time from src/lib/clock.ts. With this set, "now" is
# fixed, so the seed data and every threshold are reproducible. Unset it to use
# the real clock.
TIDEWELL_NOW="2026-11-16T09:00:00Z"

# 32-byte hex key for the fields that are encrypted at rest (names, emails).
TIDEWELL_ENCRYPTION_KEY="6f1d0c9a4b7e23581f0a9c3d5e7b2146a8c0d4f6e19b3a5c7d2e4f608a1b3c5d"
TIDEWELL_HASH_SALT="9a7c5e3b1d0f2a4c6e8b0d1f3a5c7e9b"

# The message store is a separate system from the database. Each call costs
# this much latency, as a remote document store would.
TIDEWELL_STORE_LATENCY_MS=25

# The email provider rejects sends above this rate with a RateLimitError.
TIDEWELL_EMAIL_MAX_PER_SECOND=5
